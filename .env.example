# Copy this file to .env and fill in the values you have.
# Every key is optional: with none set, the pipeline still runs end to end
# using rule-based evidence extraction and unauthenticated GitHub calls.

# --- LLM providers (primary, then fallback) --------------------------------
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- GitHub -----------------------------------------------------------------
# A personal access token with NO scopes is enough (public data only).
# Without it GitHub allows 60 requests/hour, which still covers one batch.
GITHUB_TOKEN=

# --- Optional tuning ----------------------------------------------------------
# LLM_TOKENS_PER_MINUTE=7000     # pacing budget (Groq free tier allows 8,000)
# LLM_CONCURRENCY=1
# GITHUB_CONCURRENCY=5
# CACHE_DIR=.cache
# USE_DISK_CACHE=true

# --- Eligibility policy switches ----------------------------------------------
# REQUIRE_PYTHON_USAGE=false     # true: Python only in a skills list is rejected
# ALLOW_CLASSICAL_ML=true        # false: classical ML/CV-only profiles are rejected
